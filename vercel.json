{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ahmedbello.com"
        }
      ],
      "destination": "https://www.ahmedbello.com/:path*",
      "permanent": true
    },
    { "source": "/news", "destination": "/what-changed", "permanent": true },
    { "source": "/financial-news", "destination": "/what-changed", "permanent": true },
    { "source": "/fr/news", "destination": "/fr/what-changed", "permanent": true },
    { "source": "/fr/financial-news", "destination": "/fr/what-changed", "permanent": true },
    { "source": "/blindspots", "destination": "/costly-blindspots", "permanent": true },
    { "source": "/fr/blindspots", "destination": "/fr/costly-blindspots", "permanent": true },
    { "source": "/financial-calculators", "destination": "/calculators", "permanent": true },
    { "source": "/fr/financial-calculators", "destination": "/fr/calculators", "permanent": true },
    { "source": "/fr/simulateurs", "destination": "/fr/calculators", "permanent": true },
    { "source": "/health-workers", "destination": "/for/healthcare", "permanent": true },
    { "source": "/doctors-nurses", "destination": "/for/healthcare", "permanent": true },
    { "source": "/for/health-workers", "destination": "/for/healthcare", "permanent": true },
    { "source": "/for/doctors-nurses", "destination": "/for/healthcare", "permanent": true },
    { "source": "/fr/health-workers", "destination": "/fr/for/healthcare", "permanent": true },
    { "source": "/fr/doctors-nurses", "destination": "/fr/for/healthcare", "permanent": true },
    { "source": "/fr/for/health-workers", "destination": "/fr/for/healthcare", "permanent": true },
    { "source": "/fr/for/doctors-nurses", "destination": "/fr/for/healthcare", "permanent": true },
    { "source": "/for/entrepreneurs", "destination": "/for/business-owners", "permanent": true },
    { "source": "/for/incorporated", "destination": "/for/business-owners", "permanent": true },
    { "source": "/fr/for/entrepreneurs", "destination": "/fr/for/business-owners", "permanent": true },
    { "source": "/fr/for/incorporated", "destination": "/fr/for/business-owners", "permanent": true },
    { "source": "/for/immigrants", "destination": "/for/newcomers", "permanent": true },
    { "source": "/for/new-to-canada", "destination": "/for/newcomers", "permanent": true },
    { "source": "/fr/for/immigrants", "destination": "/fr/for/newcomers", "permanent": true },
    { "source": "/fr/for/new-to-canada", "destination": "/fr/for/newcomers", "permanent": true },
    { "source": "/for/parents", "destination": "/for/families", "permanent": true },
    { "source": "/fr/for/parents", "destination": "/fr/for/families", "permanent": true },
    { "source": "/for/muslim-investors", "destination": "/investing/islamic-equity", "permanent": true },
    { "source": "/fr/for/muslim-investors", "destination": "/fr/investing/islamic-equity", "permanent": true },
    { "source": "/become-an-agent", "destination": "/careers", "permanent": true },
    { "source": "/fr/become-an-agent", "destination": "/fr/careers", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), vr=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png|jpg|jpeg|svg|webp|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
