rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ping check collection for SDK connection verification
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Leads & Subscribers: All client direct writes are strictly DENIED.
    // Ingestion occurs exclusively through authenticated server-side handlers
    // utilizing the Firebase Admin SDK with service account credentials,
    // eliminating client-side CASL tampering, bot injections, and rule bypass.
    match /leads/{leadId} {
      allow read, write: if false;
    }

    match /subscribers/{subscriberId} {
      allow read, write: if false;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
