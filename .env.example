# ==============================================================================
# Ahmed Bello Financial Practice - Vercel & Production Environment Variables
# ==============================================================================

# Contact Form & Recruitment Application Delivery (Resend API)
# Get your API Key from https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"

# Recipient inbox(es) where client enquiries and agent applications are delivered (comma-separated)
CONTACT_TO_EMAIL="enquiries@ahmedbello.com"

# Verified sender email in Resend (your custom domain address once verified in Resend)
CONTACT_FROM_EMAIL="Ahmed Bello <enquiries@ahmedbello.com>"

# Canonical Production Site URL
APP_URL="https://ahmedbello.com"

# CASL Double Opt-in Cryptographic Token Signing Secret (Required for double opt-in; fails closed if omitted)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="your_cryptographically_secure_random_hex_string_min_32_chars"

# Optional Cloudflare Turnstile anti-bot verification keys
TURNSTILE_SECRET_KEY=""
VITE_TURNSTILE_SITE_KEY=""

# Optional Firebase Service Account JSON for serverless hosting environments (Vercel)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
